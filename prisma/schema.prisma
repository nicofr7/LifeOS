generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  image         String?
  plan          String    @default("free") // free, pro, lifetime
  currency      String    @default("USD")
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripePriceId          String?
  planEndedAt            DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expenses          Expense[]
  savingsGoals      SavingsGoal[]
  recommendations   Recommendation[]
  settings          UserSettings?
  notifications     Notification[]
  sessions          Session[]
  auditLogs         AuditLog[]
  monthlySnapshots  MonthlySnapshot[]
  passwordResets    PasswordReset[]
  savingsAchieved   SavingsAchieved[]
  expensePreferences ExpensePreference[]

  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model Expense {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  description         String?
  category            String   @default("other")
  monthlyCost         Float
  billingFrequency    String   @default("monthly") // weekly, bi-weekly, monthly, every-2-months, quarterly, semi-annual, yearly
  annualCost          Float    @default(0)
  nextBillingDate     DateTime?
  provider            String?
  website             String?
  notes               String?
  currency            String   @default("USD")
  isEssential         Boolean  @default(true)
  usageStatus         String   @default("active") // active, rarely_used, dont_use
  cancellationDifficulty String @default("easy") // easy, medium, hard
  isArchived          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceHistory      PriceHistory[]
  recommendations   Recommendation[]
  renewalReminders  RenewalReminder[]
  savingsAchieved   SavingsAchieved[]
  preferences       ExpensePreference[]

  @@index([userId])
  @@index([userId, isArchived])
  @@index([userId, category])
  @@index([userId, usageStatus])
  @@index([nextBillingDate])
}

model PriceHistory {
  id        String   @id @default(cuid())
  expenseId String
  price     Float
  previousPrice Float?
  date      DateTime @default(now())
  notes     String?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([expenseId, date])
}

model Recommendation {
  id              String   @id @default(cuid())
  expenseId       String
  userId          String
  type            String   // cancel, downgrade, switch_provider, negotiate, change_billing, remove_duplicate, review_price_increase, keep
  reason          String
  estimatedSaving Float
  confidence      String   @default("medium") // high, medium, low
  dataUsed        String   @default("calculated") // calculated, estimated, ai_recommendation
  difficulty      String   @default("easy") // easy, medium, hard
  isActive        Boolean  @default(false)
  isDismissed     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingsAchieved SavingsAchieved[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([expenseId])
}

model SavingsGoal {
  id           String   @id @default(cuid())
  userId       String
  name         String
  targetAmount Float
  currentAmount Float  @default(0)
  goalType     String   @default("amount") // amount, monthly_reduction
  deadline     DateTime?
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RenewalReminder {
  id        String   @id @default(cuid())
  expenseId String
  userId    String
  remindAt  DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([userId, remindAt])
  @@index([userId, sent])
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  currency           String   @default("USD")
  emailNotifications Boolean  @default(true)
  savingsAlerts      Boolean  @default(true)
  renewalReminders   Boolean  @default(true)
  weeklyReport       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("info") // info, warning, saving, renewal, goal
  actionUrl String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // expense.created, expense.updated, expense.deleted, goal.created, etc.
  entity    String   // expense, goal, recommendation, settings
  entityId  String?
  details   String?  // JSON string with change details
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model MonthlySnapshot {
  id            String   @id @default(cuid())
  userId        String
  year          Int
  month         Int      // 1-12
  totalMonthly  Float    // Total monthly spending for this month
  totalAnnual   Float    // Annualized spending for this month
  expenseCount  Int      // Number of active expenses
  potentialSavings Float // Potential savings for this month
  categoryBreakdown String? // JSON string of category -> monthly cost
  biggestChanges String?   // JSON string of biggest changes vs previous month
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
  @@index([userId, year, month])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([token, used])
}

model SavingsAchieved {
  id              String   @id @default(cuid())
  userId          String
  expenseId       String?
  recommendationId String?
  actionType      String   // cancelled, downgraded, negotiated, changed_billing, other
  description     String
  previousMonthly Float    // What the user was paying before
  newMonthly      Float    // What the user is paying now (0 if cancelled)
  monthlySaving   Float    // Calculated: previousMonthly - newMonthly
  annualSaving    Float    // monthlySaving * 12
  confirmedAt     DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense        Expense?       @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, confirmedAt])
  @@index([expenseId])
}

model ExpensePreference {
  id        String   @id @default(cuid())
  userId    String
  expenseId String
  preference String  // keep, ignore_recommendation, dont_suggest_again
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([userId, expenseId])
  @@index([userId])
  @@index([expenseId])
}
